{
  "name": "Nordic Weather Events",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "python -m streamlit run app.py --server.address 0.0.0.0 --server.headless true"
  },
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Weather Event Explorer",
      "onAutoForward": "openPreview"
    }
  }
}
